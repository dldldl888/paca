# Required stable deployment UUID. Generate once with uuidgen, save it here,
# and use the same value for API, agent-runner and realtime. Keep it on restart
# and upgrade; reuse an existing deployment ID rather than generating another.
PACA_INSTANCE_ID=

# ── services/realtime environment variables ───────────────────────────────────
# Copy this file to .env for local development outside Docker.
# All variables listed here are required unless a default is shown.

# Port the HTTP + Socket.IO server listens on.
PORT=3001

# Internal URL of services/api used for token verification and permission lookups.
# When running outside Docker, point this at the API directly (not through Caddy).
API_URL=http://localhost:8080

# Same existing internal key as API's AI_AGENT_INTERNAL_KEY and runner's
# INTERNAL_API_KEY. Do not generate a separate key for realtime.
INTERNAL_API_KEY=

# Valkey / Redis connection URL.  Must point to the same instance the API uses.
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed CORS origins (browser clients).
CORS_ORIGINS=http://localhost:3000,http://localhost

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Set to "production" to enable structured JSON logging.
NODE_ENV=development
